{
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:5173",
    "http://localhost:3000",
    "https://app.proxar.com.ar",
    "https://proxar-cyan.vercel.app"
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/proxar-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Encryption": {
    "_comment": "⚠️ PRODUCTION: Set Encryption:Key via environment variable (64 hex chars, 32 bytes). Generate with: openssl rand -hex 32",
    "Key": ""
  },
  "Afip": {
    "_comment": "⚠️ Configuración para integración con AFIP. Las credenciales reales van en .env (ignorado por git)",
    "Environment": "Testing",
    "Cuit": "",
    "CertificatePath": "",
    "PrivateKeyPath": "",
    "CertificatePassword": ""
  }
}
